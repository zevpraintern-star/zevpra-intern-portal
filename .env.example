####################################################################
# Zevpra Intern Internship Platform - environment template
# Copy to .env.local (development) or configure in your host (production).
# NEVER commit real secrets. See docs/DEPLOYMENT.md for the full matrix.
####################################################################

# ------------------------------------------------------------------
# Application / branding (centralized - change here to rebrand)
# ------------------------------------------------------------------
NODE_ENV=development
APP_URL=http://localhost:3000
COMPANY_DOMAIN=localhost:3000
COMPANY_NAME=Zevpra Intern
COMPANY_SHORT_NAME=Zevpra Intern
COMPANY_LEGAL_NAME=
SUPPORT_EMAIL=support@example.com
CONTACT_EMAIL=support@example.com
PRIMARY_COLOR=#4f46e5
SECONDARY_COLOR=#06b6d4

# ------------------------------------------------------------------
# Database (PostgreSQL). Prisma CLI reads DATABASE_URL via prisma7.config.ts
# DIRECT_URL is used for migrations when DATABASE_URL points at a pooler.
# ------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/internship_portal?schema=public
DIRECT_URL=
PG_POOL_MAX=10
PG_CONNECTION_TIMEOUT_MS=10000

# ------------------------------------------------------------------
# Redis (OTP throttling, rate limiting, ephemeral auth, caching)
# Required in production. Left empty in dev => in-memory fallback (dev only).
# ------------------------------------------------------------------
REDIS_URL=redis://localhost:6379
REDIS_PREFIX=ip:
REDIS_TLS=false

# ------------------------------------------------------------------
# Sessions / auth
# ------------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
SESSION_COOKIE_NAME=ip_session
STUDENT_SESSION_TTL_HOURS=720
ADMIN_SESSION_TTL_MINUTES=120
SESSION_ROTATE_AFTER_MINUTES=30

# ------------------------------------------------------------------
# Email OTP
# ------------------------------------------------------------------
OTP_TTL_MINUTES=5
OTP_LENGTH=6
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_RESENDS_PER_HOUR=5
# Pepper applied on top of OTP hashing (rotate = invalidate all pending OTPs)
OTP_HASH_PEPPER=

# ------------------------------------------------------------------
# Rate limits (requests / window minutes). See src/lib/security/rate-limit.ts
# ------------------------------------------------------------------
RL_OTP_REQUEST_LIMIT=5
RL_OTP_REQUEST_WINDOW_MINUTES=15
RL_OTP_VERIFY_LIMIT=10
RL_OTP_VERIFY_WINDOW_MINUTES=15
RL_REGISTER_LIMIT=10
RL_REGISTER_WINDOW_MINUTES=60
RL_LOGIN_LIMIT=10
RL_LOGIN_WINDOW_MINUTES=15
RL_ADMIN_LOGIN_LIMIT=5
RL_ADMIN_LOGIN_WINDOW_MINUTES=15
RL_CERTIFICATE_VERIFY_LIMIT=30
RL_CERTIFICATE_VERIFY_WINDOW_MINUTES=1
RL_PAYMENT_PROOF_LIMIT=5
RL_PAYMENT_PROOF_WINDOW_MINUTES=60
RL_CONTACT_LIMIT=5
RL_CONTACT_WINDOW_MINUTES=60
RL_UPLOAD_LIMIT=20
RL_UPLOAD_WINDOW_MINUTES=60

# ------------------------------------------------------------------
# Transactional email — delivered exclusively via Brevo (formerly Sendinblue).
# Required. Put your Brevo v3 API key here (deployment) — never commit it.
# Free tier ~300 emails/day. EMAIL_FROM must be a verified sender in Brevo.
# Set up SPF, DKIM and DMARC for the sending domain or emails land in spam.
# ------------------------------------------------------------------
BREVO_API_KEY=
EMAIL_FROM="Zevpra Intern <no-reply@example.com>"
EMAIL_REPLY_TO=

# ------------------------------------------------------------------
# Private object storage (S3 / Cloudflare R2 / MinIO).
# STORAGE_DRIVER=local is a development-only filesystem driver.
# ------------------------------------------------------------------
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=./storage
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_FORCE_PATH_STYLE=true
SIGNED_URL_TTL_SECONDS=300
MAX_UPLOAD_SIZE_MB=5

# ------------------------------------------------------------------
# Payments (manual UPI verification - no payment gateway)
# Values are seeded into app_settings and are admin-editable at runtime.
# ------------------------------------------------------------------
UPI_ID=
UPI_PAYEE_NAME=
CERTIFICATE_FEE=50
CURRENCY=INR
PAYMENT_UPI_QR_STORAGE_KEY=

# ------------------------------------------------------------------
# Security / anti-bot / monitoring
# ------------------------------------------------------------------
TURNSTILE_ENABLED=false
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
CORS_ALLOWED_ORIGINS=
LOG_LEVEL=info

# ------------------------------------------------------------------
# Seeding
# ------------------------------------------------------------------
SEED_SUPER_ADMIN_EMAIL=
SEED_SUPER_ADMIN_NAME=
SEED_SUPER_ADMIN_PASSWORD=
SEED_DEMO_DATA=false

# Background jobs: secret for POST /api/internal/jobs (call it from a cron every minute),
# and an optional GitHub token to raise the repository-check rate limit.
JOB_RUNNER_SECRET=
GITHUB_TOKEN=
