  UNDER_REVIEW
  APPROVED
  REJECTED
  CHANGES_REQUESTED
}

enum ProjectStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

/// Completion review of the final project. The GitHub repository link is a
