  APPLICATION_REJECTED
  INTERNSHIP_STARTED
  TASK_ASSIGNED
  SUBMISSION_RECEIVED
  SUBMISSION_APPROVED
  SUBMISSION_REJECTED
  SUBMISSION_CHANGES_REQUESTED
  CERTIFICATE_ELIGIBLE
  PAYMENT_SUBMITTED
  PAYMENT_APPROVED
  PAYMENT_REJECTED
  CERTIFICATE_ISSUED
  ANNOUNCEMENT
  SECURITY_ALERT
  SYSTEM
