  STUDENT_LOGOUT
  APPLICATION_SUBMITTED
  APPLICATION_APPROVED
  APPLICATION_REJECTED
  INTERNSHIP_ASSIGNED
  STUDENT_SUSPENDED
  STUDENT_REACTIVATED
  TASK_CREATED
  TASK_UPDATED
  TASK_DELETED
  SUBMISSION_REVIEWED
  PROJECT_CREATED
  PROJECT_UPDATED
  COMPLETION_SUBMITTED
  COMPLETION_APPROVED
  COMPLETION_REJECTED
  CERTIFICATE_ELIGIBLE
  PAYMENT_SUBMITTED
  PAYMENT_APPROVED
  PAYMENT_REJECTED
  CERTIFICATE_GENERATED
  CERTIFICATE_REVOKED
