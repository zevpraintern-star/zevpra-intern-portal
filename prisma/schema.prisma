// ============================================================================
// Zevpra Intern - Internship Platform
// Prisma schema (Prisma ORM 7 / PostgreSQL)
//
// Conventions
//  - UUID primary keys (v7 where the generator supports it) via @default(uuid(7))
//  - snake_case table names via @@map, camelCase fields in TypeScript
//  - created_at / updated_at on every mutable business table
//  - Partial/unique indexes declared in the schema, never only in application code
//
// The datasource URL is intentionally NOT declared here: Prisma 7 resolves it
// from prisma7.config.ts for the CLI and from the driver adapter at runtime.
// ============================================================================

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum RoleKey {
  STUDENT
  MENTOR
  ADMIN
  SUPER_ADMIN
}

enum OtpPurpose {
  STUDENT_REGISTER
  STUDENT_LOGIN
  ADMIN_LOGIN
  EMAIL_VERIFY
  PASSWORD_RESET
}

/// Student and admin sessions are stored in separate namespaces (SessionKind)
/// so a stolen student cookie can never be replayed against /admin.
enum SessionKind {
  STUDENT
  ADMIN
}

enum DifficultyLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum ProgramStatus {
  DRAFT
  PUBLISHED
  CLOSED
  ARCHIVED
}

enum BatchStatus {
  PLANNED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
  WITHDRAWN
}

enum EnrollmentStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  DROPPED
}

enum TaskStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum TaskSubmissionType {
  FILE
  GITHUB_LINK
  LIVE_URL
  TEXT
  MIXED
}

enum TaskAssignmentStatus {
  ASSIGNED
  IN_PROGRESS
  SUBMITTED
  COMPLETED
  OVERDUE
  CANCELLED
}

enum SubmissionStatus {
